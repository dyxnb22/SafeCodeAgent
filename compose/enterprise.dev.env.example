# Disposable development credentials for compose.enterprise.yaml (v2.1.7).
# Copy to compose/enterprise.dev.env and adjust locally; do not use in production.

SAC_ENTERPRISE_RUNTIME_MODE=server
SAC_ENTERPRISE_DATABASE_URL=postgresql://safecode:safecode_dev@postgres:5432/safecode_enterprise_dev
SAC_ENTERPRISE_OIDC_ISSUER=https://issuer.example
SAC_ENTERPRISE_OIDC_AUDIENCE=safecode-enterprise
SAC_ENTERPRISE_OIDC_JWKS_PATH=/app/compose/.enterprise-dev-oidc/jwks.json
SAC_ENTERPRISE_API_HOST=0.0.0.0
SAC_ENTERPRISE_API_PORT=8080
SAC_ENTERPRISE_ARTIFACTS_ROOT=/var/lib/safecode
SAC_ENTERPRISE_PROJECT_ROOT=/app
SAC_ENTERPRISE_EVAL_BASELINES_ROOT=/app/tests/enterprise/eval/baselines
SAC_ENTERPRISE_WORKER_ID=worker-dev-1
SAC_ENTERPRISE_WORKER_POLL_SECONDS=1.0

POSTGRES_USER=safecode
POSTGRES_PASSWORD=safecode_dev
POSTGRES_DB=safecode_enterprise_dev
